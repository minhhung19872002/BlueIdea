# =============================================================================
# Biến môi trường cho docker-compose. Sao chép thành `.env` rồi đổi giá trị.
# TUYỆT ĐỐI KHÔNG commit tệp `.env` thật.
# =============================================================================

# --- Cổng máy chủ (đổi nếu cổng mặc định đã bị chiếm trên máy) ---------------
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SEQ_PORT=5341
AI_PORT=8088
API_PORT=8080
WEB_PORT=3000

# --- Mật khẩu hạ tầng --------------------------------------------------------
POSTGRES_PASSWORD=doi-mat-khau-nay
REDIS_PASSWORD=doi-mat-khau-nay
MINIO_USER=blueidea
MINIO_PASSWORD=doi-mat-khau-nay

# --- Khoá bảo mật ứng dụng ---------------------------------------------------
# Khoá ký JWT: tối thiểu 32 ký tự.
#   Sinh khoá:  openssl rand -base64 48
JWT_KHOA_KY=DOI-KHOA-NAY-TOI-THIEU-32-KY-TU-TRUOC-KHI-TRIEN-KHAI

# Khoá mã hoá AES-256 cho dữ liệu nhạy cảm (số CCCD, secret tích hợp).
# Phải là base64 của đúng 32 byte.
#   Sinh khoá:  openssl rand -base64 32
MA_HOA_KHOA=ZG9pLWtob2EtbmF5LXRydW9jLWtoaS10cmllbi1raGE=

# --- Môi trường --------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
VITE_API_URL=http://localhost:8080

# --- Đăng nhập một lần SSO (chức năng 21, 41) --------------------------------
# Để trống SSO_ISSUER hoặc SSO_CLIENT_ID = tắt SSO; trang đăng nhập tự ẩn nút
# "Đăng nhập một lần (SSO)".
#
# Redirect URI phải đăng ký với nhà cung cấp đúng địa chỉ: <địa-chỉ-web>/dang-nhap/sso
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE=openid profile email

# --- Ký số văn bản (chức năng 49) --------------------------------------------
# Đường dẫn tệp PFX chứa chứng thư ký, tính theo bên trong container api.
# Gắn tệp vào container bằng volume rồi trỏ đường dẫn vào đây; KHÔNG lưu khoá ký
# trong cơ sở dữ liệu.
#   Ví dụ:  KYSO_PFX=/app/du-lieu/chung-thu.pfx
KYSO_PFX=
KYSO_MAT_KHAU_PFX=

# --- Sao lưu dữ liệu ---------------------------------------------------------
# Thư mục chứa các bản sao lưu do deploy/sao-luu-blueidea.sh tạo ra, tính theo
# máy chủ. Được gắn CHỈ ĐỌC vào container api để màn hình Sao lưu liệt kê được
# các bản đang có; tạo bản mới và khôi phục vẫn chạy bằng script trên máy chủ.
THU_MUC_SAO_LUU=/var/backups/blueidea
