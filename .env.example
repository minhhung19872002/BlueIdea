# =============================================================================
# Biến môi trường cho docker-compose. Sao chép thành `.env` rồi đổi giá trị.
# TUYỆT ĐỐI KHÔNG commit tệp `.env` thật.
# =============================================================================

# --- Cổng máy chủ (đổi nếu cổng mặc định đã bị chiếm) ------------------------
POSTGRES_PORT=5432

# --- Mật khẩu hạ tầng --------------------------------------------------------
POSTGRES_PASSWORD=doi-mat-khau-nay
REDIS_PASSWORD=doi-mat-khau-nay
MINIO_USER=blueidea
MINIO_PASSWORD=doi-mat-khau-nay

# --- Khoá bảo mật ứng dụng ---------------------------------------------------
# Khoá ký JWT: tối thiểu 32 ký tự.
#   Sinh khoá:  openssl rand -base64 48
JWT_KHOA_KY=DOI-KHOA-NAY-TOI-THIEU-32-KY-TU-TRUOC-KHI-TRIEN-KHAI

# Khoá mã hoá AES-256 cho dữ liệu nhạy cảm (số CCCD, secret tích hợp).
# Phải là base64 của đúng 32 byte.
#   Sinh khoá:  openssl rand -base64 32
MA_HOA_KHOA=ZG9pLWtob2EtbmF5LXRydW9jLWtoaS10cmllbi1raGE=

# --- Môi trường --------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
VITE_API_URL=http://localhost:8080
