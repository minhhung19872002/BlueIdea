# =============================================================================
# Web React + Vite, phuc vu bang Nginx (nen Brotli/Gzip, SPA fallback).
# =============================================================================

FROM node:20-alpine AS build
WORKDIR /nguon

COPY web/package.json web/package-lock.json* web/pnpm-lock.yaml* ./
RUN npm install

COPY web/ ./

ARG VITE_API_URL=http://localhost:8080
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

RUN apk add --no-cache tzdata \
    && cp /usr/share/zoneinfo/Asia/Ho_Chi_Minh /etc/localtime \
    && echo "Asia/Ho_Chi_Minh" > /etc/timezone

COPY deploy/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /nguon/dist /usr/share/nginx/html

EXPOSE 80

# Bat buoc dung 127.0.0.1 chu khong phai "localhost": trong container, "localhost"
# phan giai ra ::1 truoc, trong khi Nginx chi lang nghe IPv4 0.0.0.0:80. BusyBox wget
# khong tu chuyen sang dia chi con lai nen se bao "Connection refused" du web van chay.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
